file(GLOB descs ${CORPUS}/*.bin)
foreach(desc ${descs})
    string(REGEX REPLACE "\\.bin$" ".slots" expected ${desc})
    execute_process(COMMAND ${DUMP} --slots ${desc} OUTPUT_VARIABLE got RESULT_VARIABLE rc)
    file(READ ${expected} want)
    if(NOT rc EQUAL 0 OR NOT got STREQUAL want)
        message(FATAL_ERROR "corpus mismatch: ${desc}")
    endif()
endforeach()
